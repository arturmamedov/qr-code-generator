# QR Code Manager - Environment Variables
# Copy this file to .env for local development
# In Coolify, set these as environment variables in the dashboard

# Database Driver: mysql or sqlite
DB_DRIVER=mysql

# MySQL Configuration (when DB_DRIVER=mysql)
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# SQLite Configuration (when DB_DRIVER=sqlite)
# DB_SQLITE_PATH=/path/to/data/qr_codes.db

# Application URL (no trailing slash)
BASE_URL=https://qr.example.com

# Error Logging (true = log to file, false = display errors)
ENABLE_ERROR_LOG=true

# Optional: Override paths (defaults work for most setups)
# GENERATED_PATH=/custom/path/to/generated
# LOGS_PATH=/custom/path/to/logs
# ERROR_LOG_FILE=/custom/path/to/error.log

# Optional: QR Code defaults
# QR_CODE_LENGTH=6
# QR_MAX_SLUG_LENGTH=33
# QR_DEFAULT_SIZE=300

# Timezone
# TIMEZONE=UTC

# Supabase Auth (leave empty to use .htaccess HTTP Basic Auth instead)
# Get these from: Supabase Dashboard → Settings → API
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_JWT_SECRET=your-jwt-secret
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
